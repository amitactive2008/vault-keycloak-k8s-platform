// ============================================================
// CI Pipeline — Sample React App (team-b): Node.js API
//
// Jenkins folder : team-b/sample-react-app/api/ci
// Source code    : https://github.com/amitactive2008/DevSecOps-Mega-Project.git
// Docker image   : amitactive2008/sample-react-app-api:team-b-<BUILD_NUMBER>
//                  amitactive2008/sample-react-app-api:team-b-latest
// Vault path     : secret/data/team-b/sample-react-app/api
// Namespace      : team-b
//
// Stages:
//   1. Checkout   — git clone from public GitHub repo
//   2. Install    — npm ci + syntax check
//   3. Gitleaks   — secret scan
//   4. OWASP SCA  — npm dependency CVE scan
//   5. SonarQube  — SAST + quality gate
//   6. Docker     — buildx (linux/amd64,linux/arm64) → push team-b-tagged image
//   7. Trivy      — image vulnerability scan
//   8. Trigger CD — fire team-b/sample-react-app/api/cd
// ============================================================
pipeline {
  agent {
    kubernetes {
      yamlFile '08-jenkins/Jenkins-agent.yaml'
      defaultContainer 'jnlp'
    }
  }

  environment {
    REGISTRY    = "amitactive2008"
    IMAGE_NAME  = "sample-react-app-api"
    TEAM        = "team-b"
    IMAGE_TAG   = "${TEAM}-${BUILD_NUMBER}"   // e.g. team-b-42
    SONAR_PROJECT = "sample-react-app-team-b-api"
    // Source code is at root of DevSecOps-Mega-Project
    APP_DIR     = "api"
  }

  options {
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '10'))
    timeout(time: 30, unit: 'MINUTES')
  }

  stages {

    stage('Stage 1: Checkout') {
      steps {
        echo "Checking out source from public GitHub repo..."
        git branch: 'dev',
            url: 'https://github.com/amitactive2008/DevSecOps-Mega-Project.git'
        sh 'git log --oneline -3'
      }
    }

    stage('Stage 2: Install & Lint') {
      steps {
        container('nodejs') {
          dir("${APP_DIR}") {
            sh 'npm ci --prefer-offline'
            sh 'find . -name "*.js" -not -path "*/node_modules/*" -exec node --check {} +'
            echo "Install and syntax check passed ✓"
          }
        }
      }
    }

    stage('Stage 3: Gitleaks Scan') {
      steps {
        container('gitleaks') {
          sh """
            gitleaks detect \
              --source ${APP_DIR} \
              --report-format json \
              --report-path gitleaks-team-b-api-report.json \
              --no-git || true
          """
        }
      }
    }

    stage('Stage 4: OWASP SCA') {
      steps {
        container('dependency-check') {
          dir("${APP_DIR}") {
            withCredentials([string(credentialsId: 'NVD_API_KEY', variable: 'NVD_KEY')]) {
              sh '''
                NVD_OPTS=""
                [ -n "$NVD_KEY" ] && [ "$NVD_KEY" != "placeholder" ] && NVD_OPTS="--nvdApiKey $NVD_KEY"
                /usr/share/dependency-check/bin/dependency-check.sh \
                  --scan . --project sample-react-app-team-b-api \
                  --data /dependency-check-data $NVD_OPTS \
                  --out reports --format HTML --format JSON \
                  --failOnCVSS 11 || true
              '''
            }
          }
        }
      }
    }

    stage('Stage 5: SonarQube SAST') {
      steps {
        container('sonar') {
          withSonarQubeEnv('mysonarqube') {
            sh """
              sonar-scanner \
                -Dsonar.projectKey=${SONAR_PROJECT} \
                -Dsonar.projectName="Sample React App Team-B API" \
                -Dsonar.sources=${APP_DIR} \
                -Dsonar.exclusions=**/node_modules/**,**/reports/**
            """
          }
        }
      }
    }

    stage('Stage 6: Quality Gate') {
      steps {
        timeout(time: 2, unit: 'MINUTES') {
          script {
            def qg = waitForQualityGate()
            echo "Quality Gate: ${qg.status}"
          }
        }
      }
    }

    stage('Stage 7: Docker Build & Push') {
      steps {
        echo "Building image: ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}"
        container('docker-cli') {
          dir("${APP_DIR}") {
            withCredentials([usernamePassword(
              credentialsId: 'dockerhub',
              usernameVariable: 'DOCKER_USER',
              passwordVariable: 'DOCKER_PASS'
            )]) {
              sh """
                echo "\$DOCKER_PASS" | docker login -u "\$DOCKER_USER" --password-stdin

                docker buildx create \
                  --name ${TEAM}-buildkitd \
                  --driver remote \
                  tcp://buildkitd.jenkins.svc.cluster.local:1234 \
                  --use --bootstrap 2>/dev/null || docker buildx use ${TEAM}-buildkitd

                # Tag includes team name: team-b-<BUILD_NUMBER> and team-b-latest
                docker buildx build \
                  --platform linux/amd64,linux/arm64 \
                  --push \
                  -t ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG} \
                  -t ${REGISTRY}/${IMAGE_NAME}:${TEAM}-latest \
                  .

                docker buildx rm ${TEAM}-buildkitd || true
              """
            }
          }
        }
      }
    }

    stage('Stage 8: Trivy Image Scan') {
      steps {
        container('trivy') {
          sh """
            trivy image --format json \
              -o trivy-team-b-api-report.json \
              --exit-code 0 \
              ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG} || true
            trivy image --format table --exit-code 0 \
              ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG} || true
          """
        }
      }
    }

    stage('Stage 9: Trigger CD') {
      steps {
        build job: 'team-b/sample-react-app/api/cd',
          parameters: [string(name: 'IMAGE_TAG', value: "${IMAGE_TAG}")],
          wait: false
      }
    }

  }

  post {
    always {
      archiveArtifacts artifacts: 'gitleaks-team-b-api-report.json,trivy-team-b-api-report.json,api/reports/**',
                       allowEmptyArchive: true
    }
    success { echo "✓ team-b API CI passed → ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}" }
    failure { echo "✗ team-b API CI failed" }
  }
}
