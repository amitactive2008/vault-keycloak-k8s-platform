// ============================================================
// CI Pipeline — Sample React App (team-b): React Client
//
// Jenkins folder : team-b/sample-react-app/client/ci
// Source code    : https://github.com/amitactive2008/DevSecOps-Mega-Project.git
// Docker image   : amitactive2008/sample-react-app-client:team-b-<BUILD_NUMBER>
//                  amitactive2008/sample-react-app-client:team-b-latest
//
// Stages:
//   1. Checkout    — git clone from public GitHub repo
//   2. Install     — npm ci + syntax check
//   3. Gitleaks    — secret scan
//   4. Unit Tests  — npm test --coverage
//   5. OWASP SCA   — npm dependency CVE scan
//   6. SonarQube   — SAST + quality gate
//   7. Docker      — buildx multi-platform → push team-b-tagged image
//   8. Trivy       — image CVE scan
//   9. Trigger CD  — fire team-b/sample-react-app/client/cd
// ============================================================
pipeline {
  agent {
    kubernetes {
      yamlFile '08-jenkins/Jenkins-agent.yaml'
      defaultContainer 'jnlp'
    }
  }

  environment {
    REGISTRY    = "amitactive2008"
    IMAGE_NAME  = "sample-react-app-client"
    TEAM        = "team-b"
    IMAGE_TAG   = "${TEAM}-${BUILD_NUMBER}"
    SONAR_PROJECT = "sample-react-app-team-b-client"
    APP_DIR     = "client"
  }

  options {
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '10'))
    timeout(time: 30, unit: 'MINUTES')
  }

  stages {

    stage('Stage 1: Checkout') {
      steps {
        git branch: 'dev',
            url: 'https://github.com/amitactive2008/DevSecOps-Mega-Project.git'
        sh 'git log --oneline -3'
      }
    }

    stage('Stage 2: Install & Lint') {
      steps {
        container('nodejs') {
          dir("${APP_DIR}") {
            sh 'npm ci --prefer-offline'
            sh 'find src -name "*.js" -not -name "*.test.js" -exec node --check {} + 2>&1 || true'
          }
        }
      }
    }

    stage('Stage 3: Gitleaks Scan') {
      steps {
        container('gitleaks') {
          sh """
            gitleaks detect --source ${APP_DIR} \
              --report-format json \
              --report-path gitleaks-team-b-client-report.json \
              --no-git || true
          """
        }
      }
    }

    stage('Stage 4: Unit Tests') {
      steps {
        container('nodejs') {
          dir("${APP_DIR}") {
            sh 'npm test -- --coverage --watchAll=false --ci'
          }
        }
      }
    }

    stage('Stage 5: OWASP SCA') {
      steps {
        container('dependency-check') {
          dir("${APP_DIR}") {
            withCredentials([string(credentialsId: 'NVD_API_KEY', variable: 'NVD_KEY')]) {
              sh '''
                NVD_OPTS=""
                [ -n "$NVD_KEY" ] && [ "$NVD_KEY" != "placeholder" ] && NVD_OPTS="--nvdApiKey $NVD_KEY"
                /usr/share/dependency-check/bin/dependency-check.sh \
                  --scan . --project sample-react-app-team-b-client \
                  --data /dependency-check-data $NVD_OPTS \
                  --out reports --format HTML --format JSON \
                  --failOnCVSS 11 || true
              '''
            }
          }
        }
      }
    }

    stage('Stage 6: SonarQube SAST') {
      steps {
        container('sonar') {
          withSonarQubeEnv('mysonarqube') {
            sh """
              sonar-scanner \
                -Dsonar.projectKey=${SONAR_PROJECT} \
                -Dsonar.projectName="Sample React App Team-B Client" \
                -Dsonar.sources=${APP_DIR}/src \
                -Dsonar.exclusions=**/*.test.js,**/setupTests.js,**/reportWebVitals.js \
                -Dsonar.javascript.lcov.reportPaths=${APP_DIR}/coverage/lcov.info
            """
          }
        }
      }
    }

    stage('Stage 7: Quality Gate') {
      steps {
        timeout(time: 2, unit: 'MINUTES') {
          script { def qg = waitForQualityGate(); echo "Quality Gate: ${qg.status}" }
        }
      }
    }

    stage('Stage 8: Docker Build & Push') {
      steps {
        container('docker-cli') {
          dir("${APP_DIR}") {
            withCredentials([usernamePassword(
              credentialsId: 'dockerhub',
              usernameVariable: 'DOCKER_USER',
              passwordVariable: 'DOCKER_PASS'
            )]) {
              sh """
                echo "\$DOCKER_PASS" | docker login -u "\$DOCKER_USER" --password-stdin
                docker buildx create --name ${TEAM}-buildkitd \
                  --driver remote tcp://buildkitd.jenkins.svc.cluster.local:1234 \
                  --use --bootstrap 2>/dev/null || docker buildx use ${TEAM}-buildkitd
                docker buildx build \
                  --platform linux/amd64,linux/arm64 \
                  --push \
                  -t ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG} \
                  -t ${REGISTRY}/${IMAGE_NAME}:${TEAM}-latest \
                  .
                docker buildx rm ${TEAM}-buildkitd || true
              """
            }
          }
        }
      }
    }

    stage('Stage 9: Trivy Scan') {
      steps {
        container('trivy') {
          sh """
            trivy image --format json -o trivy-team-b-client-report.json \
              --exit-code 0 ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG} || true
          """
        }
      }
    }

    stage('Stage 10: Trigger CD') {
      steps {
        build job: 'team-b/sample-react-app/client/cd',
          parameters: [string(name: 'IMAGE_TAG', value: "${IMAGE_TAG}")],
          wait: false
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: 'gitleaks-team-b-client-report.json,trivy-team-b-client-report.json,client/reports/**',
                       allowEmptyArchive: true
    }
    success { echo "✓ team-b Client CI passed → ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}" }
    failure { echo "✗ team-b Client CI failed" }
  }
}
