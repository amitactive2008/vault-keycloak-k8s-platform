// ============================================================
// CD Pipeline — Sample React App (team-b): React Client
//
// Jenkins folder : team-b/sample-react-app/client/cd
// Triggered by   : team-b/sample-react-app/client/ci
// Namespace      : team-b
// ============================================================
pipeline {
  agent {
    kubernetes {
      yamlFile '08-jenkins/Jenkins-agent-cd.yaml'
      defaultContainer 'kubectl'
    }
  }

  parameters {
    string(name: 'IMAGE_TAG', defaultValue: 'team-b-latest',
           description: 'Docker image tag (e.g. team-b-42 from Client CI)')
  }

  environment {
    REGISTRY   = "amitactive2008"
    IMAGE_NAME = "sample-react-app-client"
    NAMESPACE  = "team-b"
    DEPLOY     = "sample-react-app-client"
    MANIFESTS  = "10-sample-react-app-team-b/kubernetes"
  }

  options {
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '20'))
    timeout(time: 10, unit: 'MINUTES')
  }

  stages {
    stage('Stage 1: Checkout') {
      steps { checkout scm; sh 'git log --oneline -3' }
    }

    stage('Stage 2: Apply Manifests') {
      steps {
        sh """
          kubectl create namespace ${NAMESPACE} --dry-run=client -o yaml | kubectl apply -f -
          kubectl apply -f ${MANIFESTS}/client/       -n ${NAMESPACE}
          kubectl apply -f ${MANIFESTS}/httproute.yaml -n ${NAMESPACE}
        """
      }
    }

    stage('Stage 3: Update Image Tag') {
      steps {
        sh """
          kubectl set image deployment/${DEPLOY} \
            client=${REGISTRY}/${IMAGE_NAME}:${params.IMAGE_TAG} \
            -n ${NAMESPACE}
        """
      }
    }

    stage('Stage 4: Wait for Rollout') {
      steps {
        sh """
          kubectl rollout status deployment/${DEPLOY} -n ${NAMESPACE} --timeout=5m
          kubectl get pods -n ${NAMESPACE} -l app=sample-react-app-client
        """
      }
    }

    stage('Stage 5: Smoke Test') {
      steps {
        sh """
          POD=\$(kubectl get pod -l app=sample-react-app-client -n ${NAMESPACE} \
            -o jsonpath='{.items[0].metadata.name}' 2>/dev/null || echo "")
          [ -n "\$POD" ] && \
            kubectl exec \$POD -n ${NAMESPACE} -c client -- \
              wget -qO- http://localhost:80/ | grep -c "DevOps Shack" && echo "Client OK ✓" || true
        """
      }
    }
  }

  post {
    success { echo "✓ team-b Client deployed: ${REGISTRY}/${IMAGE_NAME}:${params.IMAGE_TAG} → https://sample-react-app-team-b.kind.local" }
    failure { sh "kubectl get pods -n ${NAMESPACE} || true" }
  }
}
