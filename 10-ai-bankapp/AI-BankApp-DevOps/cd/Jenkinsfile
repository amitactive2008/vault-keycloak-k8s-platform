pipeline {
  agent {
    kubernetes {
      yamlFile '08-jenkins/Jenkins-agent-cd-team-b.yaml'
      defaultContainer 'kubectl'
    }
  }

  parameters {
    string(name: 'IMAGE_TAG', defaultValue: 'team-b-latest',
           description: 'AI BankApp image tag produced by Team B CI')
  }

  environment {
    NAMESPACE   = 'team-b'
    REGISTRY    = 'amitactive2008'
    IMAGE_NAME  = 'ai-bankapp'
    DEPLOYMENT  = 'ai-bankapp'
    MANIFESTS   = '10-ai-bankapp/AI-BankApp-DevOps/kubernetes'
  }

  options {
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '20'))
    timeout(time: 30, unit: 'MINUTES')
  }

  stages {
    stage('Validate Local Target') {
      steps {
        sh '''
          test "$(cat /var/run/secrets/kubernetes.io/serviceaccount/namespace)" = "jenkins"
          kubectl get --raw=/version >/dev/null
          kubectl auth can-i create deployments -n "$NAMESPACE" | grep -qx yes
          kubectl auth can-i patch statefulsets -n "$NAMESPACE" | grep -qx yes
          kubectl auth can-i create namespaces | grep -qx no
        '''
      }
    }

    stage('Apply Platform Resources') {
      steps {
        sh '''
          kubectl apply -f "$MANIFESTS/serviceaccount.yaml"
          kubectl apply -f "$MANIFESTS/mysql.yaml"
          kubectl apply -f "$MANIFESTS/ollama.yaml"
          kubectl apply -f "$MANIFESTS/application.yaml"
          kubectl apply -f "$MANIFESTS/httproute.yaml"
        '''
      }
    }

    stage('Prepare MySQL and Ollama') {
      steps {
        sh '''
          kubectl rollout status statefulset/ai-bankapp-mysql \
            -n "$NAMESPACE" --timeout=7m
          kubectl rollout status deployment/ai-bankapp-ollama \
            -n "$NAMESPACE" --timeout=7m
          if ! kubectl exec -n "$NAMESPACE" deployment/ai-bankapp-ollama \
              -- ollama list | awk 'NR > 1 {print $1}' |
              grep -Eq '^tinyllama(:latest)?$'; then
            kubectl exec -n "$NAMESPACE" deployment/ai-bankapp-ollama \
              -- ollama pull tinyllama
          fi
        '''
      }
    }

    stage('Deploy Immutable Image') {
      steps {
        sh """
          kubectl set image deployment/${DEPLOYMENT} \
            bankapp=${REGISTRY}/${IMAGE_NAME}:${params.IMAGE_TAG} \
            -n ${NAMESPACE}
          kubectl rollout status deployment/${DEPLOYMENT} \
            -n ${NAMESPACE} --timeout=7m
        """
      }
    }

    stage('Smoke Test') {
      steps {
        sh '''
          APP_POD="$(kubectl get pods -n "$NAMESPACE" \
            -l app.kubernetes.io/name=ai-bankapp \
            -o jsonpath='{.items[0].metadata.name}')"
          kubectl exec -n "$NAMESPACE" "$APP_POD" -c bankapp -- \
            wget -qO- http://127.0.0.1:8080/actuator/health |
            grep -q '"status":"UP"'
          kubectl wait --for=jsonpath='{.status.parents[0].conditions[?(@.type=="Accepted")].status}'=True \
            httproute/ai-bankapp -n "$NAMESPACE" --timeout=2m
        '''
      }
    }

    stage('DAST (Audit)') {
      steps {
        catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
          container('zap') {
            sh '''
              zap-baseline.py \
                -t http://ai-bankapp.team-b.svc.cluster.local:8080 \
                -r zap-report.html \
                -J zap-report.json \
                -I
            '''
          }
        }
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: 'zap-report.html,zap-report.json',
                       allowEmptyArchive: true
    }
    success {
      echo "Deployed: ${REGISTRY}/${IMAGE_NAME}:${params.IMAGE_TAG}"
    }
    failure {
      sh '''
        kubectl get pods,svc,httproute -n "$NAMESPACE" || true
        kubectl describe deployment "$DEPLOYMENT" -n "$NAMESPACE" || true
      '''
    }
  }
}
