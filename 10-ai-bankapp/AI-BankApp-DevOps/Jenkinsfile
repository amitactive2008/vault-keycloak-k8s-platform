// Team B AI BankApp CI. Maven tests are intentionally skipped as requested.
pipeline {
  agent {
    kubernetes {
      yamlFile '08-jenkins/Jenkins-agent-team-b.yaml'
      defaultContainer 'jnlp'
    }
  }

  environment {
    APP_DIR    = '10-ai-bankapp/AI-BankApp-DevOps'
    REGISTRY   = 'amitactive2008'
    IMAGE_NAME = 'ai-bankapp'
    IMAGE_TAG  = "team-b-${BUILD_NUMBER}"
    CHART_DIR  = 'helm/ai-bankapp'
    CHART_NAME = 'ai-bankapp-chart'
    CHART_VERSION = "0.1.${BUILD_NUMBER}"
  }

  options {
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '10'))
    timeout(time: 60, unit: 'MINUTES')
  }

  stages {
    stage('Gitleaks') {
      steps {
        container('gitleaks') {
          dir("${APP_DIR}") {
            sh '''
              gitleaks detect --source . --no-git \
                --report-format json \
                --report-path gitleaks-report.json
            '''
          }
        }
      }
    }

    stage('Checkstyle') {
      steps {
        container('maven') {
          dir("${APP_DIR}") {
            sh './mvnw checkstyle:check -DskipTests -B || true'
          }
        }
      }
    }

    stage('Semgrep') {
      steps {
        container('semgrep') {
          dir("${APP_DIR}") {
            sh '''
              SCAN_ROOT="/src${WORKSPACE#/home/jenkins/agent}/${APP_DIR}"
              test -d "$SCAN_ROOT"
              semgrep scan \
                --config p/java \
                --config p/owasp-top-ten \
                --config p/secrets \
                --error \
                --json-output semgrep-report.json \
                "$SCAN_ROOT"
            '''
          }
        }
      }
    }

    stage('Maven Package (Tests Skipped)') {
      steps {
        container('maven') {
          dir("${APP_DIR}") {
            sh './mvnw clean package -DskipTests -B'
          }
        }
      }
    }

    stage('Build Scan Image') {
      steps {
        container('docker-cli') {
          dir("${APP_DIR}") {
            sh '''
              docker buildx create \
                --name "team-b-bankapp-${BUILD_NUMBER}" \
                --driver remote \
                tcp://buildkitd.jenkins.svc.cluster.local:1234 \
                --use --bootstrap
              docker buildx build \
                --platform linux/amd64 \
                --output type=docker,dest=bankapp-image.tar \
                .
            '''
          }
        }
      }
    }

    stage('Trivy') {
      steps {
        container('trivy') {
          dir("${APP_DIR}") {
            sh '''
              trivy image \
                --input bankapp-image.tar \
                --severity HIGH,CRITICAL \
                --ignore-unfixed \
                --exit-code 1 \
                --format json \
                --output trivy-report.json
            '''
          }
        }
      }
    }

    stage('Push to Docker Hub') {
      steps {
        container('docker-cli') {
          dir("${APP_DIR}") {
            sh '''
              set +x
              DOCKER_USER="$(cat /vault/secrets/dockerhub-username)"
              DOCKER_TOKEN="$(cat /vault/secrets/dockerhub-token)"
              printf '%s' "$DOCKER_TOKEN" |
                docker login --username "$DOCKER_USER" --password-stdin
              docker buildx build \
                --platform linux/amd64,linux/arm64 \
                --push \
                -t "${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}" \
                -t "${REGISTRY}/${IMAGE_NAME}:team-b-latest" \
                .
              docker logout
              unset DOCKER_TOKEN
              docker buildx rm "team-b-bankapp-${BUILD_NUMBER}" || true
            '''
          }
        }
      }
    }

    stage('Publish Helm Chart to Docker Hub') {
      steps {
        container('helm') {
          dir("${APP_DIR}") {
            sh '''
              set -e
              helm lint "$CHART_DIR" -f helm/team-b-values.yaml \
                --set-string image.tag="$IMAGE_TAG"
              mkdir -p helm/dist
              helm package "$CHART_DIR" \
                --version "$CHART_VERSION" \
                --app-version "$IMAGE_TAG" \
                --destination helm/dist

              set +x
              DOCKER_USER="$(cat /vault/secrets/dockerhub-username)"
              DOCKER_TOKEN="$(cat /vault/secrets/dockerhub-token)"
              printf '%s' "$DOCKER_TOKEN" |
                helm registry login registry-1.docker.io \
                  --username "$DOCKER_USER" --password-stdin
              helm push "helm/dist/${CHART_NAME}-${CHART_VERSION}.tgz" \
                "oci://registry-1.docker.io/${REGISTRY}"
              helm registry logout registry-1.docker.io
              unset DOCKER_TOKEN
            '''
          }
        }
      }
    }

    stage('Trigger CD') {
      steps {
        build job: 'team-b/ai-bankapp/cd',
          parameters: [
            string(name: 'IMAGE_TAG', value: "${IMAGE_TAG}"),
            string(name: 'CHART_VERSION', value: "${CHART_VERSION}")
          ],
          wait: false
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: '10-ai-bankapp/AI-BankApp-DevOps/gitleaks-report.json,10-ai-bankapp/AI-BankApp-DevOps/semgrep-report.json,10-ai-bankapp/AI-BankApp-DevOps/trivy-report.json,10-ai-bankapp/AI-BankApp-DevOps/target/*.jar,10-ai-bankapp/AI-BankApp-DevOps/helm/dist/*.tgz',
        allowEmptyArchive: true
    }
    success {
      echo "Image published: ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}"
      echo "Chart published: oci://registry-1.docker.io/${REGISTRY}/${CHART_NAME}:${CHART_VERSION}"
    }
  }
}
