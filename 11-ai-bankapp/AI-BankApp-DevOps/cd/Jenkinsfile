pipeline {
  agent {
    kubernetes {
      yamlFile '08-jenkins/Jenkins-agent-cd-team-b.yaml'
      defaultContainer 'kubectl'
    }
  }

  parameters {
    string(name: 'IMAGE_TAG', defaultValue: 'team-b-latest',
           description: 'AI BankApp image tag produced by Team B CI')
    string(name: 'CHART_VERSION', defaultValue: '0.1.1',
           description: 'OCI Helm chart version produced by Team B CI')
  }

  environment {
    NAMESPACE   = 'team-b'
    REGISTRY    = 'amitactive2008'
    IMAGE_NAME  = 'ai-bankapp'
    DEPLOYMENT  = 'ai-bankapp'
    RELEASE     = 'ai-bankapp'
    CHART       = 'oci://registry-1.docker.io/amitactive2008/ai-bankapp-chart'
    VALUES_FILE = '10-ai-bankapp/AI-BankApp-DevOps/helm/team-b-values.yaml'
  }

  options {
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '20'))
    timeout(time: 30, unit: 'MINUTES')
  }

  stages {
    stage('Validate Local Target') {
      steps {
        sh '''
          test "$(cat /var/run/secrets/kubernetes.io/serviceaccount/namespace)" = "jenkins"
          kubectl get --raw=/version >/dev/null
          kubectl auth can-i create deployments -n "$NAMESPACE" | grep -qx yes
          kubectl auth can-i patch statefulsets -n "$NAMESPACE" | grep -qx yes
          kubectl auth can-i list replicasets -n "$NAMESPACE" | grep -qx yes
          kubectl auth can-i create secrets -n "$NAMESPACE" | grep -qx yes
          kubectl auth can-i create namespaces | grep -qx no
        '''
      }
    }

    stage('Pull and Deploy Helm Chart') {
      steps {
        container('helm') {
          sh '''
            # Take ownership of the previous kubectl-managed resources only on
            # the first Helm install. Later upgrades get atomic rollback.
            HELM_SAFETY_ARGS="--take-ownership"
            if helm status "$RELEASE" --namespace "$NAMESPACE" >/dev/null 2>&1; then
              HELM_SAFETY_ARGS="--atomic"
            fi
            helm upgrade --install "$RELEASE" "$CHART" \
              --version "$CHART_VERSION" \
              --namespace "$NAMESPACE" \
              --values "$VALUES_FILE" \
              --set-string image.tag="$IMAGE_TAG" \
              $HELM_SAFETY_ARGS \
              --wait \
              --timeout 10m \
              --history-max 10
          '''
        }
      }
    }

    stage('Prepare MySQL and Ollama') {
      steps {
        sh '''
          kubectl rollout status statefulset/ai-bankapp-mysql \
            -n "$NAMESPACE" --timeout=7m
          kubectl rollout status deployment/ai-bankapp-ollama \
            -n "$NAMESPACE" --timeout=7m
          if ! kubectl exec -n "$NAMESPACE" deployment/ai-bankapp-ollama \
              -- ollama list | awk 'NR > 1 {print $1}' |
              grep -Eq '^tinyllama(:latest)?$'; then
            kubectl exec -n "$NAMESPACE" deployment/ai-bankapp-ollama \
              -- ollama pull tinyllama
          fi
        '''
      }
    }

    stage('Smoke Test') {
      steps {
        sh '''
          APP_POD="$(kubectl get pods -n "$NAMESPACE" \
            -l app.kubernetes.io/name=ai-bankapp \
            -o jsonpath='{.items[0].metadata.name}')"
          kubectl exec -n "$NAMESPACE" "$APP_POD" -c bankapp -- \
            wget -qO- http://127.0.0.1:8080/actuator/health |
            grep -q '"status":"UP"'
          kubectl wait --for=jsonpath='{.status.parents[0].conditions[?(@.type=="Accepted")].status}'=True \
            httproute/ai-bankapp -n "$NAMESPACE" --timeout=2m
        '''
      }
    }

    stage('DAST (Audit)') {
      steps {
        catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
          container('zap') {
            sh '''
              zap-baseline.py \
                -t http://ai-bankapp.team-b.svc.cluster.local:8080 \
                -r zap-report.html \
                -J zap-report.json \
                -I
              cp /zap/wrk/zap-report.html "$WORKSPACE/zap-report.html"
              cp /zap/wrk/zap-report.json "$WORKSPACE/zap-report.json"
            '''
          }
        }
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: 'zap-report.html,zap-report.json',
                       allowEmptyArchive: true
    }
    success {
      echo "Deployed chart ${CHART}:${params.CHART_VERSION} with image ${REGISTRY}/${IMAGE_NAME}:${params.IMAGE_TAG}"
    }
    failure {
      sh '''
        kubectl get pods,svc,httproute -n "$NAMESPACE" || true
        kubectl describe deployment "$DEPLOYMENT" -n "$NAMESPACE" || true
      '''
    }
  }
}
