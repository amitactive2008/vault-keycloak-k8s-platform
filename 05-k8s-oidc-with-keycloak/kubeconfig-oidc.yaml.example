# Reference shape only. Run ./setup.sh to generate kubeconfig-oidc.yaml with
# cluster-specific CA data and the correct absolute CA path.
apiVersion: v1
kind: Config
clusters:
  - name: kind-vault
    cluster:
      certificate-authority-data: <cluster-ca-base64>
      server: https://127.0.0.1:6443
contexts:
  - name: devops
    context:
      cluster: kind-vault
      namespace: default
      user: devops-oidc
  - name: team-a
    context:
      cluster: kind-vault
      namespace: team-a
      user: team-a-oidc
  - name: team-b
    context:
      cluster: kind-vault
      namespace: team-b
      user: team-b-oidc
current-context: team-a
users:
  - name: devops-oidc
    user:
      exec: &oidc-login
        apiVersion: client.authentication.k8s.io/v1beta1
        command: kubectl
        args:
          - oidc-login
          - get-token
          - --oidc-issuer-url=https://keycloak.kind.local/realms/kind
          - --oidc-client-id=kubernetes
          - --oidc-auth-request-extra-params=prompt=login
          - --certificate-authority=<absolute-path-to-generated-ca>
        env:
          - name: GODEBUG
            value: netdns=go
        interactiveMode: IfAvailable
        provideClusterInfo: false
  - name: team-a-oidc
    user:
      exec: *oidc-login
  - name: team-b-oidc
    user:
      exec: *oidc-login
