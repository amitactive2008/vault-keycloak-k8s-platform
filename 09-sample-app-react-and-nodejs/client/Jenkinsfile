// Team A React client CI. Application source is checked out from the public
// DevSecOps-Mega-Project repository.
pipeline {
  agent {
    kubernetes {
      yamlFile '08-jenkins/Jenkins-agent.yaml'
      defaultContainer 'jnlp'
    }
  }

  parameters {
    string(name: 'SOURCE_BRANCH', defaultValue: 'dev',
           description: 'Application source branch to build')
  }

  environment {
    REGISTRY      = 'amitactive2008'
    IMAGE_NAME    = 'sample-react-app-client'
    IMAGE_TAG     = "team-a-${BUILD_NUMBER}"
    APP_DIR       = 'client'
    SONAR_PROJECT = 'sample-react-app-team-a-client'
  }

  options {
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '10'))
    timeout(time: 45, unit: 'MINUTES')
  }

  stages {
    stage('Checkout Source') {
      steps {
        git branch: params.SOURCE_BRANCH,
            url: 'https://github.com/amitactive2008/DevSecOps-Mega-Project.git'
        sh 'git log -1 --oneline'
      }
    }

    stage('Install and Test') {
      steps {
        container('nodejs') {
          dir("${APP_DIR}") {
            sh 'npm ci --prefer-offline'
            sh 'CI=true npm test -- --coverage --watchAll=false'
          }
        }
      }
    }

    stage('Gitleaks') {
      steps {
        container('gitleaks') {
          sh """
            gitleaks detect --source ${APP_DIR} --no-git \
              --report-format json \
              --report-path gitleaks-team-a-client.json || true
          """
        }
      }
    }

    stage('Dependency Check') {
      steps {
        container('dependency-check') {
          dir("${APP_DIR}") {
            withCredentials([string(credentialsId: 'NVD_API_KEY', variable: 'NVD_KEY')]) {
              sh '''
                NVD_OPTS=""
                [ -n "$NVD_KEY" ] && NVD_OPTS="--nvdApiKey $NVD_KEY"
                /usr/share/dependency-check/bin/dependency-check.sh \
                  --scan . --project sample-react-app-team-a-client \
                  --data /dependency-check-data $NVD_OPTS \
                  --out reports --format HTML --format JSON \
                  --failOnCVSS 11 || true
              '''
            }
          }
        }
      }
    }

    stage('SonarQube') {
      steps {
        container('sonar') {
          withSonarQubeEnv('mysonarqube') {
            sh """
              sonar-scanner \
                -Dsonar.projectKey=${SONAR_PROJECT} \
                -Dsonar.projectName='Sample React App Team A Client' \
                -Dsonar.sources=${APP_DIR}/src \
                -Dsonar.exclusions=**/*.test.js,**/setupTests.js,**/reportWebVitals.js \
                -Dsonar.javascript.lcov.reportPaths=${APP_DIR}/coverage/lcov.info
            """
          }
        }
      }
    }

    stage('Quality Gate') {
      steps {
        catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
          timeout(time: 2, unit: 'MINUTES') {
            waitForQualityGate abortPipeline: false
          }
        }
      }
    }

    stage('Build and Push Image') {
      steps {
        container('docker-cli') {
          dir("${APP_DIR}") {
            withCredentials([usernamePassword(
              credentialsId: 'dockerhub',
              usernameVariable: 'DOCKER_USER',
              passwordVariable: 'DOCKER_PASS'
            )]) {
              sh """
                echo "\$DOCKER_PASS" | docker login -u "\$DOCKER_USER" --password-stdin
                docker buildx create \
                  --name team-a-client-${BUILD_NUMBER} \
                  --driver remote \
                  tcp://buildkitd.jenkins.svc.cluster.local:1234 \
                  --use --bootstrap
                docker buildx build \
                  --platform linux/amd64,linux/arm64 \
                  --push \
                  -t ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG} \
                  -t ${REGISTRY}/${IMAGE_NAME}:team-a-latest \
                  .
                docker buildx rm team-a-client-${BUILD_NUMBER} || true
              """
            }
          }
        }
      }
    }

    stage('Trivy') {
      steps {
        container('trivy') {
          sh """
            trivy image --format json --output trivy-team-a-client.json \
              --exit-code 0 ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG} || true
          """
        }
      }
    }

    stage('Trigger CD') {
      steps {
        build job: 'team-a/sample-react-app/client/cd',
          parameters: [string(name: 'IMAGE_TAG', value: "${IMAGE_TAG}")],
          wait: false
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: 'gitleaks-team-a-client.json,trivy-team-a-client.json,client/reports/**',
                       allowEmptyArchive: true
    }
    success {
      echo "Client image published: ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}"
    }
  }
}

