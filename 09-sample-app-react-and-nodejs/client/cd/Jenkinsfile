pipeline {
  agent {
    kubernetes {
      yamlFile '08-jenkins/Jenkins-agent-cd.yaml'
      defaultContainer 'kubectl'
    }
  }

  parameters {
    string(name: 'IMAGE_TAG', defaultValue: 'team-a-latest',
           description: 'Client image tag produced by Team A CI')
  }

  environment {
    REGISTRY   = 'amitactive2008'
    IMAGE_NAME = 'sample-react-app-client'
    NAMESPACE  = 'team-a'
    DEPLOYMENT = 'sample-react-app-client'
    MANIFESTS  = '09-sample-app-react-and-nodejs/kubernetes'
  }

  options {
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '20'))
    timeout(time: 10, unit: 'MINUTES')
  }

  stages {
    stage('Apply Client Infrastructure') {
      steps {
        withCredentials([file(credentialsId: 'external-kubeconfig', variable: 'KUBECONFIG')]) {
          sh '''
            kubectl apply -f "$MANIFESTS/client/"
            kubectl apply -f "$MANIFESTS/httproute.yaml"
          '''
        }
      }
    }

    stage('Deploy Client Image') {
      steps {
        withCredentials([file(credentialsId: 'external-kubeconfig', variable: 'KUBECONFIG')]) {
          sh """
            kubectl set image deployment/${DEPLOYMENT} \
              client=${REGISTRY}/${IMAGE_NAME}:${params.IMAGE_TAG} \
              -n ${NAMESPACE}
          """
        }
      }
    }

    stage('Verify Client') {
      steps {
        withCredentials([file(credentialsId: 'external-kubeconfig', variable: 'KUBECONFIG')]) {
          sh '''
            kubectl rollout status deployment/"$DEPLOYMENT" \
              -n "$NAMESPACE" --timeout=5m
            kubectl exec -n "$NAMESPACE" deployment/"$DEPLOYMENT" -c client -- \
              wget -qO- http://localhost/
          '''
        }
      }
    }
  }

  post {
    success {
      echo "Client deployed: ${REGISTRY}/${IMAGE_NAME}:${params.IMAGE_TAG}"
    }
    failure {
      withCredentials([file(credentialsId: 'external-kubeconfig', variable: 'KUBECONFIG')]) {
        sh 'kubectl get pods -n "$NAMESPACE" || true'
      }
    }
  }
}
