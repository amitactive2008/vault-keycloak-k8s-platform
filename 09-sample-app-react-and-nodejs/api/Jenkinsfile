// ============================================================
// CI Pipeline — Sample React App: Node.js API
//
// Jenkins folder: team-a/sample-react-app/api/ci
//
// Stages:
//   1. Checkout         — pull source from SCM
//   2. Install & Lint   — npm ci + node --check syntax validation
//   3. Gitleaks         — secret / credential leak scan
//   4. OWASP SCA        — dependency vulnerability scan
//   5. SonarQube SAST   — static analysis + security scan
//   6. Quality Gate     — block on SonarQube threshold
//   7. Docker Build     — build image via BuildKit, push to DockerHub
//   8. Trivy Scan       — container image vulnerability scan
//   9. Trigger CD       — kick off team-a/sample-react-app/api/cd
//
// Secrets injected at runtime:
//   Vault path: secret/data/team-a/sample-react-app/api
//   Jenkins credentials: dockerhub (username/password)
//                        NVD_API_KEY (string)
//                        sonarqube-token (string)
// ============================================================
pipeline {
  agent {
    kubernetes {
      // Uses the shared CI agent pod defined in 08-jenkins/Jenkins-agent.yaml.
      // Path is relative to the SCM workspace root after checkout.
      yamlFile '08-jenkins/Jenkins-agent.yaml'
      defaultContainer 'jnlp'
    }
  }

  environment {
    // Docker Hub image coordinates
    REGISTRY    = "amitactive2008"
    API_IMAGE   = "sample-react-app-api"
    IMAGE_TAG   = "${BUILD_NUMBER}"

    // SonarQube project key (matches project created in sonarqube-values.yaml setup)
    SONAR_PROJECT = "sample-react-app-api"

    // Subdirectory containing the API source (relative to repo root)
    APP_DIR = "09-sample-app-react-and-nodejs/api"

    // Vault auth role for K8s auth (used in CD, documented here for reference)
    VAULT_ROLE = "team-a-sample-react-app"
  }

  options {
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '10'))
    timeout(time: 30, unit: 'MINUTES')
  }

  stages {

    // ── Stage 1: Checkout ───────────────────────────────────────────────────
    stage('Stage 1: Checkout') {
      steps {
        echo "Checking out source code..."
        checkout scm
        // Print the commit that was built for traceability
        sh 'git log --oneline -3'
      }
    }

    // ── Stage 2: Install & Lint ─────────────────────────────────────────────
    stage('Stage 2: Install & Lint') {
      steps {
        echo "Installing dependencies and checking syntax..."
        container('nodejs') {
          dir("${APP_DIR}") {
            sh 'npm ci --prefer-offline'
            // Validate JavaScript syntax across all source files
            sh '''
              find . -name "*.js" \
                -not -path "*/node_modules/*" \
                -not -path "*/reports/*" \
                -exec node --check {} +
            '''
            echo "Dependency install and syntax check passed ✓"
          }
        }
      }
    }

    // ── Stage 3: Gitleaks — Secret Scan ────────────────────────────────────
    stage('Stage 3: Gitleaks Scan') {
      steps {
        echo "Scanning for secrets and credentials in source..."
        container('gitleaks') {
          sh """
            gitleaks detect \
              --source ${APP_DIR} \
              --report-format json \
              --report-path gitleaks-api-report.json \
              --no-git \
              --verbose || true
          """
          sh 'cat gitleaks-api-report.json 2>/dev/null || echo "No report generated"'
        }
      }
    }

    // ── Stage 4: OWASP Dependency Check (SCA) ──────────────────────────────
    stage('Stage 4: OWASP SCA') {
      steps {
        echo "Running OWASP Dependency-Check on npm packages..."
        container('dependency-check') {
          dir("${APP_DIR}") {
            withCredentials([string(credentialsId: 'NVD_API_KEY', variable: 'NVD_KEY')]) {
              sh '''
                NVD_OPTS=""
                if [ -n "$NVD_KEY" ] && [ "$NVD_KEY" != "placeholder" ]; then
                  NVD_OPTS="--nvdApiKey $NVD_KEY"
                fi
                /usr/share/dependency-check/bin/dependency-check.sh \
                  --scan . \
                  --project sample-react-app-api \
                  --data /dependency-check-data \
                  $NVD_OPTS \
                  --out reports \
                  --format HTML \
                  --format JSON \
                  --failOnCVSS 11 || true
              '''
            }
          }
        }
      }
    }

    // ── Stage 5: SonarQube SAST ─────────────────────────────────────────────
    stage('Stage 5: SonarQube SAST') {
      steps {
        echo "Running SonarQube static analysis..."
        container('sonar') {
          withSonarQubeEnv('mysonarqube') {
            sh """
              sonar-scanner \
                -Dsonar.projectKey=${SONAR_PROJECT} \
                -Dsonar.projectName="Sample React App - API" \
                -Dsonar.sources=${APP_DIR} \
                -Dsonar.exclusions=**/node_modules/**,**/reports/**,**/*.test.js \
                -Dsonar.dependencyCheck.jsonReportPath=${APP_DIR}/reports/dependency-check-report.json \
                -Dsonar.dependencyCheck.htmlReportPath=${APP_DIR}/reports/dependency-check-report.html
            """
          }
        }
      }
    }

    // ── Stage 6: Quality Gate ───────────────────────────────────────────────
    stage('Stage 6: Quality Gate') {
      steps {
        script {
          timeout(time: 2, unit: 'MINUTES') {
            def qg = waitForQualityGate()
            echo "Quality Gate status: ${qg.status}"
            if (qg.status != 'OK') {
              // Log but don't fail for demo purposes — set to 'error()' in production
              echo "WARNING: Quality Gate failed with status ${qg.status}"
            }
          }
        }
      }
    }

    // ── Stage 7: Docker Build & Push ────────────────────────────────────────
    // Uses Docker Buildx with the in-cluster buildkitd (non-TLS, jenkins namespace).
    // Pushes:  amitactive2008/sample-react-app-api:<BUILD_NUMBER>
    //          amitactive2008/sample-react-app-api:latest
    stage('Stage 7: Docker Build & Push') {
      steps {
        echo "Building Docker image: ${REGISTRY}/${API_IMAGE}:${IMAGE_TAG}"
        container('docker-cli') {
          dir("${APP_DIR}") {
            withCredentials([usernamePassword(
              credentialsId: 'dockerhub',
              usernameVariable: 'DOCKER_USER',
              passwordVariable: 'DOCKER_PASS'
            )]) {
              sh """
                # Authenticate with Docker Hub
                echo "\$DOCKER_PASS" | docker login -u "\$DOCKER_USER" --password-stdin

                # Create/reuse a Buildx builder backed by the in-cluster buildkitd
                docker buildx create \
                  --name kind-buildkitd \
                  --driver remote \
                  tcp://buildkitd.jenkins.svc.cluster.local:1234 \
                  --use \
                  --bootstrap 2>/dev/null || docker buildx use kind-buildkitd

                # Build and push both versioned and latest tags in one pass
                docker buildx build \
                  --platform linux/amd64 \
                  --push \
                  -t ${REGISTRY}/${API_IMAGE}:${IMAGE_TAG} \
                  -t ${REGISTRY}/${API_IMAGE}:latest \
                  .

                docker buildx rm kind-buildkitd || true
              """
            }
          }
        }
      }
    }

    // ── Stage 8: Trivy Image Scan ───────────────────────────────────────────
    stage('Stage 8: Trivy Image Scan') {
      steps {
        echo "Scanning container image for vulnerabilities..."
        container('trivy') {
          sh """
            trivy image \
              --format json \
              -o trivy-api-report.json \
              --exit-code 0 \
              ${REGISTRY}/${API_IMAGE}:${IMAGE_TAG} || true

            trivy image \
              --format table \
              --exit-code 0 \
              ${REGISTRY}/${API_IMAGE}:${IMAGE_TAG} || true
          """
        }
      }
    }

    // ── Stage 9: Trigger CD ─────────────────────────────────────────────────
    stage('Stage 9: Trigger CD') {
      steps {
        echo "Triggering CD pipeline with IMAGE_TAG=${IMAGE_TAG}..."
        build job: 'team-a/sample-react-app/api/cd',
          parameters: [
            string(name: 'IMAGE_TAG', value: "${IMAGE_TAG}")
          ],
          wait: false
      }
    }

  } // end stages

  post {
    always {
      archiveArtifacts(
        artifacts: 'gitleaks-api-report.json,trivy-api-report.json,09-sample-app-react-and-nodejs/api/reports/**',
        allowEmptyArchive: true
      )
    }
    success {
      echo """
        ╔══════════════════════════════════════════════════════╗
        ║  API CI PASSED                                       ║
        ║  Image: ${REGISTRY}/${API_IMAGE}:${IMAGE_TAG}        ║
        ╚══════════════════════════════════════════════════════╝
      """
    }
    failure {
      echo "✗ API CI FAILED — check stage logs above"
    }
  }
}
