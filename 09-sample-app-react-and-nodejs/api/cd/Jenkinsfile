pipeline {
  agent {
    kubernetes {
      yamlFile '08-jenkins/Jenkins-agent-cd.yaml'
      defaultContainer 'kubectl'
    }
  }

  parameters {
    string(name: 'IMAGE_TAG', defaultValue: 'team-a-latest',
           description: 'API image tag produced by Team A CI')
  }

  environment {
    REGISTRY    = 'amitactive2008'
    IMAGE_NAME  = 'sample-react-app-api'
    NAMESPACE   = 'team-a'
    DEPLOYMENT  = 'sample-react-app-api'
    MANIFESTS   = '09-sample-app-react-and-nodejs/kubernetes'
    KUBECONFIG  = '/vault/secrets/kubeconfig'
    EXPECTED_CONTEXT = 'external'
  }

  options {
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '20'))
    timeout(time: 15, unit: 'MINUTES')
  }

  stages {
    stage('Validate Target Cluster') {
      steps {
        sh '''
          test -s "$KUBECONFIG"
          ACTUAL_CONTEXT="$(kubectl config current-context)"
          test "$ACTUAL_CONTEXT" = "$EXPECTED_CONTEXT" || {
            echo "Refusing deployment: expected context '$EXPECTED_CONTEXT', got '$ACTUAL_CONTEXT'" >&2
            exit 1
          }
          kubectl get --raw=/version >/dev/null
          kubectl auth can-i create deployments -n "$NAMESPACE" | grep -qx yes
          kubectl auth can-i patch deployments -n "$NAMESPACE" | grep -qx yes
        '''
      }
    }

    stage('Apply API Infrastructure') {
      steps {
        sh '''
          kubectl apply -f "$MANIFESTS/rbac.yaml"
          kubectl apply -f "$MANIFESTS/mysql/"
          kubectl apply -f "$MANIFESTS/api/"
          kubectl apply -f "$MANIFESTS/httproute.yaml"
        '''
      }
    }

    stage('Deploy API Image') {
      steps {
        sh """
          kubectl set image deployment/${DEPLOYMENT} \
            api=${REGISTRY}/${IMAGE_NAME}:${params.IMAGE_TAG} \
            -n ${NAMESPACE}
        """
      }
    }

    stage('Verify API') {
      steps {
        sh '''
          kubectl rollout status statefulset/sample-react-app-mysql \
            -n "$NAMESPACE" --timeout=5m
          kubectl rollout status deployment/"$DEPLOYMENT" \
            -n "$NAMESPACE" --timeout=7m
          API_POD=$(kubectl get endpoints api-service -n "$NAMESPACE" \
            -o jsonpath='{.subsets[0].addresses[0].targetRef.name}')
          kubectl exec -n "$NAMESPACE" "$API_POD" -c api -- sh -c '
            attempts=0
            until wget -qO- http://127.0.0.1:5000/live &&
                  wget -qO- http://127.0.0.1:5000/health; do
              attempts=$((attempts + 1))
              [ "$attempts" -ge 10 ] && exit 1
              sleep 2
            done
          '
        '''
      }
    }
  }

  post {
    success {
      echo "API deployed: ${REGISTRY}/${IMAGE_NAME}:${params.IMAGE_TAG}"
    }
    failure {
      sh 'kubectl get pods -n "$NAMESPACE" || true'
    }
  }
}
