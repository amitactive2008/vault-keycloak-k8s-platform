// ============================================================
// CD Pipeline — Sample React App: Node.js API
//
// Jenkins folder: team-a/sample-react-app/api/cd
//
// Triggered by: team-a/sample-react-app/api/ci (passes IMAGE_TAG)
// Can also be triggered manually with an IMAGE_TAG parameter.
//
// Stages:
//   1. Checkout        — pull K8s manifests from SCM
//   2. Vault Setup     — verify Vault secrets exist for the app
//   3. Apply Manifests — kubectl apply kubernetes/ to team-a namespace
//   4. Update Image    — kubectl set image → new tag on api deployment
//   5. Rollout Wait    — wait for deployment to go healthy
//   6. Smoke Test      — hit /health and /live endpoints
//
// Prerequisites (run vault-setup.sh once before first CD run):
//   • Vault secret: secret/data/team-a/sample-react-app/api
//   • Vault policy: team-a-sample-react-app (read above path)
//   • Vault K8s auth role: team-a-sample-react-app → SA sample-react-app-backend
//   • Kubernetes Secret: sample-react-app-mysql (DB bootstrap credentials)
// ============================================================
pipeline {
  agent {
    kubernetes {
      yamlFile '08-jenkins/Jenkins-agent-cd.yaml'
      defaultContainer 'kubectl'
    }
  }

  parameters {
    string(
      name: 'IMAGE_TAG',
      defaultValue: 'latest',
      description: 'Docker image tag to deploy (build number from API CI pipeline)'
    )
  }

  environment {
    REGISTRY   = "amitactive2008"
    API_IMAGE  = "sample-react-app-api"
    NAMESPACE  = "team-a"
    DEPLOY     = "sample-react-app-api"
    APP_DIR    = "09-sample-app-react-and-nodejs"
  }

  options {
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '20'))
    timeout(time: 15, unit: 'MINUTES')
  }

  stages {

    // ── Stage 1: Checkout ───────────────────────────────────────────────────
    stage('Stage 1: Checkout') {
      steps {
        echo "Checking out Kubernetes manifests..."
        checkout scm
        sh 'git log --oneline -3'
      }
    }

    // ── Stage 2: Vault Secret Verification ─────────────────────────────────
    stage('Stage 2: Vault Secret Verification') {
      steps {
        echo "Verifying Vault secrets exist for the API..."
        sh """
          # Check that the Vault secret path exists
          # (uses the jenkins ServiceAccount token to authenticate to Vault)
          VAULT_ADDR="http://vault-active.vault.svc.cluster.local:8200"

          VAULT_TOKEN=\$(cat /var/run/secrets/kubernetes.io/serviceaccount/token)
          VAULT_K8S_TOKEN=\$(curl -sf \
            -X POST \
            "\$VAULT_ADDR/v1/auth/kubernetes/login" \
            -d "{\"jwt\": \"\$VAULT_TOKEN\", \"role\": \"team-a-sample-react-app\"}" \
            | grep -o '"client_token":"[^"]*"' | cut -d'"' -f4 || echo "")

          if [ -z "\$VAULT_K8S_TOKEN" ]; then
            echo "WARNING: Could not authenticate to Vault — Vault Agent will handle injection at runtime"
          else
            echo "Vault auth OK. Verifying secret path..."
            curl -sf \
              -H "X-Vault-Token: \$VAULT_K8S_TOKEN" \
              "\$VAULT_ADDR/v1/secret/data/team-a/sample-react-app/api" \
              > /dev/null && echo "Secret path verified ✓" || echo "WARNING: Secret path not found"
          fi
        """
      }
    }

    // ── Stage 3: Apply Kubernetes Manifests ─────────────────────────────────
    // Idempotent: creates/updates all Kubernetes resources for the app
    stage('Stage 3: Apply Manifests') {
      steps {
        echo "Applying Kubernetes manifests to namespace: ${NAMESPACE}..."
        sh """
          kubectl create namespace ${NAMESPACE} --dry-run=client -o yaml | kubectl apply -f -

          # Apply in order: RBAC → MySQL → API → Client → Networking
          kubectl apply -f ${APP_DIR}/kubernetes/rbac.yaml -n ${NAMESPACE}
          kubectl apply -f ${APP_DIR}/kubernetes/mysql/   -n ${NAMESPACE}
          kubectl apply -f ${APP_DIR}/kubernetes/api/     -n ${NAMESPACE}
          kubectl apply -f ${APP_DIR}/kubernetes/client/  -n ${NAMESPACE}
          kubectl apply -f ${APP_DIR}/kubernetes/httproute.yaml -n ${NAMESPACE}
        """
      }
    }

    // ── Stage 4: Update API Image Tag ───────────────────────────────────────
    stage('Stage 4: Update Image Tag') {
      steps {
        echo "Rolling API deployment to image tag: ${params.IMAGE_TAG}"
        sh """
          kubectl set image deployment/${DEPLOY} \
            api=${REGISTRY}/${API_IMAGE}:${params.IMAGE_TAG} \
            -n ${NAMESPACE}

          echo "Image updated: ${REGISTRY}/${API_IMAGE}:${params.IMAGE_TAG}"
        """
      }
    }

    // ── Stage 5: Wait for Rollout ───────────────────────────────────────────
    stage('Stage 5: Wait for Rollout') {
      steps {
        echo "Waiting for API rollout to complete..."
        sh """
          kubectl rollout status deployment/${DEPLOY} \
            -n ${NAMESPACE} \
            --timeout=5m

          echo ""
          echo "=== Deployed Pods ==="
          kubectl get pods -n ${NAMESPACE} -l app=sample-react-app-api

          echo ""
          echo "=== Deployment Events ==="
          kubectl describe deployment/${DEPLOY} -n ${NAMESPACE} | tail -20
        """
      }
    }

    // ── Stage 6: Smoke Test ─────────────────────────────────────────────────
    stage('Stage 6: Smoke Test') {
      steps {
        echo "Running smoke tests against deployed API..."
        sh """
          API_POD=\$(kubectl get pod \
            -l app=sample-react-app-api \
            -n ${NAMESPACE} \
            -o jsonpath='{.items[0].metadata.name}' 2>/dev/null || echo "")

          if [ -z "\$API_POD" ]; then
            echo "WARNING: No API pod found — skipping smoke test"
          else
            echo "Testing /live (liveness probe)..."
            kubectl exec \$API_POD -n ${NAMESPACE} -c api -- \
              wget -qO- http://localhost:5000/live && echo " ✓"

            echo "Testing /health (DB connectivity)..."
            kubectl exec \$API_POD -n ${NAMESPACE} -c api -- \
              wget -qO- http://localhost:5000/health && echo " ✓"
          fi
        """
      }
    }

  } // end stages

  post {
    success {
      echo """
        ╔══════════════════════════════════════════════════════════════╗
        ║  API CD PASSED                                               ║
        ║  Deployed: ${REGISTRY}/${API_IMAGE}:${params.IMAGE_TAG}      ║
        ║  Namespace: ${NAMESPACE}                                      ║
        ║  Access: https://sample-react-app.kind.local/api/            ║
        ╚══════════════════════════════════════════════════════════════╝
      """
    }
    failure {
      sh """
        echo "=== CD FAILED — diagnostics ==="
        kubectl get pods -n ${NAMESPACE} --show-labels || true
        kubectl describe deployment/${DEPLOY} -n ${NAMESPACE} || true
        kubectl logs -l app=sample-react-app-api -n ${NAMESPACE} --tail=30 || true
      """
    }
  }
}
